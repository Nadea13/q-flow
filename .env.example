# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:57322/postgres

# LINE Official Account & LIFF Integration
NEXT_PUBLIC_LINE_LIFF_ID=your-liff-id
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_ADMIN_USER_ID=your-line-user-id
LINE_NOTIFY_DEFAULT_TOKEN=your-line-notify-token

# SlipOK API
SLIPOK_API_KEY=your-slipok-api-key
SLIPOK_BRANCH_ID=your-slipok-branch-id

# Stripe Subscription & Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=qflow-slips
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key
